APP_NAME="Perpustakaan Online SMKN 2 Purwakarta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Set true hanya di hosting yang sudah memakai HTTPS (mis. InfinityFree),
# supaya asset()/url() tidak menghasilkan URL http:// (Mixed Content).
APP_FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perpustakaan
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=30

# Akun Super Admin (dipakai oleh SuperAdminSeeder)
SUPERADMIN_NAME="Super Administrator"
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@smkn2pwk.sch.id
SUPERADMIN_PASSWORD=superadmin123

# Akun Admin Utama (dipakai oleh DatabaseSeeder)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smkn2pwk.sch.id
ADMIN_PASSWORD=admin123

# Reset password via OTP (Google OAuth2 / Gmail API)
PASSWORD_RESET_VIA_EMAIL=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
